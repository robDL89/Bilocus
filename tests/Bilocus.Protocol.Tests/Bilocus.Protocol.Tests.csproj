<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net48 is the Revit 2024 framework: without this TFM that path would
         never be run by the tests, even though it is one of the two
         production builds. -->
    <TargetFrameworks>net8.0;net48</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- System.Text.Json is not in the .NET Framework BCL: the package is
         needed to read the golden vectors on the Revit 2024 TFM too. -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Bilocus.Protocol\Bilocus.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
